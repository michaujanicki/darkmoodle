{
  "manifest_version": 3,
  "name": "DarkMoodle@PANS",
  "version": "3.0.11",
  "description": "Ciemny motyw dla platformy Moodle PANS Włocławek. Do wybory jest: ciemny-granatowy, ciemny-szary i ciemny-czarny, a także wyłączenie trybu ciemnego.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_title": "Ustawienia DarkMoodle@PANS",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": { "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["https://edu.pans.wloclawek.pl/*"],
      "css": ["dark-mode.css"],
      "js": ["dark-mode.js"],
      "run_at": "document_start"
    }
  ]
}
